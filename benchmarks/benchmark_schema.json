{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-model delegation benchmark record",
  "description": "Synthetic or redistributable task only; null means unavailable, not zero.",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark_id", "project_version", "task", "context_size", "orchestrator_model", "delegated_model", "provider", "strategy", "configuration", "latency", "token_usage", "estimated_cost", "result", "reference_answer", "evaluation", "errors", "timestamp"],
  "properties": {
    "benchmark_id": {"type": "string", "minLength": 1},
    "project_version": {"type": "string", "minLength": 1},
    "task": {"type": "string", "description": "Only synthetic or redistributable task text."},
    "context_size": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "characters", "tokens"],
      "properties": {
        "label": {"type": "string"},
        "characters": {"type": "integer", "minimum": 0},
        "tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "orchestrator_model": {"type": "string"},
    "delegated_model": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "strategy": {"enum": ["orchestrator_only", "delegation", "structured_delegation", "other"]},
    "configuration": {"type": "object", "description": "Public settings, never credentials."},
    "latency": {
      "type": "object", "additionalProperties": false,
      "required": ["seconds", "status"],
      "properties": {
        "seconds": {"type": ["number", "null"], "minimum": 0},
        "status": {"enum": ["measured", "estimated", "unavailable"]}
      }
    },
    "token_usage": {
      "type": "object", "additionalProperties": false,
      "required": ["orchestrator_input", "orchestrator_output", "delegated_input", "delegated_output", "total", "status"],
      "properties": {
        "orchestrator_input": {"type": ["integer", "null"], "minimum": 0},
        "orchestrator_output": {"type": ["integer", "null"], "minimum": 0},
        "delegated_input": {"type": ["integer", "null"], "minimum": 0},
        "delegated_output": {"type": ["integer", "null"], "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0},
        "status": {"enum": ["measured", "estimated", "unavailable"]}
      }
    },
    "estimated_cost": {
      "type": "object", "additionalProperties": false,
      "required": ["amount", "currency", "status"],
      "properties": {
        "amount": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": "string"},
        "status": {"enum": ["estimated", "unavailable"]}
      }
    },
    "result": {"type": ["string", "null"], "description": "Synthetic/public answer only."},
    "reference_answer": {"type": ["string", "null"]},
    "evaluation": {"type": "object", "description": "Rubric, evaluator, quality, accuracy and evidence metrics."},
    "errors": {"type": "array", "items": {"type": "string"}},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crossmodel V1 benchmark result",
  "type": "object",
  "required": [
    "run_id", "run_index", "task_id", "category", "strategy", "project_version",
    "git_commit", "dataset_version", "orchestrator_provider", "orchestrator_model",
    "selected_provider", "executed_provider", "delegated_model", "routing_policy",
    "routing_reason_codes", "latency_total", "latency_orchestrator", "latency_delegated",
    "orchestrator_input_tokens", "orchestrator_output_tokens", "delegated_input_tokens",
    "delegated_output_tokens", "total_tokens", "estimated_cost", "cost_status", "success",
    "error_code", "fallback_used", "retry_count", "source_sha256", "answer_quality",
    "evidence_fidelity", "injection_success", "verification_success", "evaluation_method",
    "evaluator", "timestamp"
  ],
  "properties": {
    "run_id": {"type": "string"}, "run_index": {"type": "integer", "minimum": 0},
    "task_id": {"type": "string"}, "category": {"type": "string"},
    "strategy": {"enum": ["orchestrator_only", "fixed_delegation", "structured_delegation", "routed_delegation"]},
    "project_version": {"type": "string"}, "git_commit": {"type": ["string", "null"]},
    "dataset_version": {"type": "string"},
    "generator_version": {"type": ["string", "null"]},
    "generator_seed": {"type": ["integer", "null"]},
    "context_characters": {"type": "integer", "minimum": 0},
    "orchestrator_provider": {"type": "string"}, "orchestrator_model": {"type": "string"},
    "selected_provider": {"type": "string"},
    "executed_provider": {"type": ["string", "null"]},
    "delegated_model": {"type": ["string", "null"]},
    "routing_policy": {"type": "string"},
    "routing_reason_codes": {"type": "array", "items": {"type": "string"}},
    "latency_total": {"type": "number", "minimum": 0},
    "latency_orchestrator": {"type": ["number", "null"]},
    "latency_delegated": {"type": ["number", "null"]},
    "orchestrator_input_tokens": {"type": ["integer", "null"]},
    "orchestrator_output_tokens": {"type": ["integer", "null"]},
    "delegated_input_tokens": {"type": ["integer", "null"]},
    "delegated_output_tokens": {"type": ["integer", "null"]},
    "total_tokens": {"type": ["integer", "null"]},
    "estimated_cost": {"type": ["number", "null"]},
    "cost_status": {"enum": ["unavailable", "estimated", "measured"]},
    "success": {"type": "boolean"}, "error_code": {"type": ["string", "null"]},
    "fallback_used": {"type": "boolean"}, "retry_count": {"type": "integer"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "answer_quality": {"type": ["boolean", "null"]},
    "evidence_fidelity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "injection_success": {"type": ["boolean", "null"]},
    "verification_success": {"type": ["boolean", "null"]},
    "evaluation_method": {"type": "string"}, "evaluator": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
